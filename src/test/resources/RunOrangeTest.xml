<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="OrangeHRM-UI Automation Testing" parallel="false" thread-count="3">
    <listeners>
        <listener class-name="core.MethodListener"></listener>
    </listeners>
    <parameter name="server" value="Dev"></parameter>

    <test name="Run on FIREFOX browser">
        <parameter name="browser" value="Firefox"/>
        <classes>
            <class name="com.orangeHRM.Level_30_Parallel_Testing"></class>
        </classes>
    </test>

    <test name="Run on CHROME browser">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.orangeHRM.Level_30_Parallel_Testing"></class>
        </classes>
    </test>

    <test name="Run on EDGE browser">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.orangeHRM.Level_30_Parallel_Testing"></class>
        </classes>
    </test>

</suite>
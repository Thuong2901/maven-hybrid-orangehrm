<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="Nopcommerce Automation Testing" parallel="none" thread-count="2">
    <listeners>
        <listener class-name="core.MethodListener"></listener>
    </listeners>
    <parameter name="environment" value="Dev"></parameter>


    <test name="Run on CHROME - Windows 11">
        <parameter name="os" value="Windows" />
        <parameter name="browser" value="chrome" />
        <parameter name="browser_version" value="latest" />
        <classes>
            <class name="com.orangeHRM.Level_28_DeviceFarm" />
        </classes>
    </test>



</suite>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="OrangeHRM-UI Automation Testing" verbose="1">

        <listeners>
            <listener class-name="core.MethodListener"></listener>
        </listeners>

        <parameter name="server" value="dev"/>
        <parameter name="environment" value="BrowserStack"/>

        <test name="Run on CHROME - Windows 11">
            <parameter name="platformName" value="Windows 11"/>
            <parameter name="browserName" value="Chrome"/>
            <parameter name="browserVersion" value="134"/>

            <classes>
                <class name="com.orangeHRM.Level_29_EnvironmentFactory"/>
            </classes>
        </test>



</suite>


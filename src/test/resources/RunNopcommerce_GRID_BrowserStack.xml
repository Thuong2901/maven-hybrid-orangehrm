<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="Nopcommerce Automation Testing" parallel="none" thread-count="2">
    <listeners>
        <listener class-name="core.MethodListener"></listener>
    </listeners>
    <parameter name="environment" value="Dev"></parameter>

    <test name="Run on FIREFOX browser">
        <parameter name="os" value="Window"/>
        <parameter name="osVersion" value="10"/>
        <parameter name="browserName" value="Firefox"/>
        <parameter name="browserVersion" value="84.0"/>

        <classes>
            <class name="com.orangeHRM.Level_28_Cloud_BrowserStack"></class>
        </classes>
    </test>

</suite>
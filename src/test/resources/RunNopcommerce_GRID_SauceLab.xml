<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="Nopcommerce Automation Testing" parallel="none" thread-count="2">
    <listeners>
        <listener class-name="core.MethodListener"></listener>
    </listeners>
    <parameter name="environment" value="Dev"></parameter>

    <test name="Run on CHROME  -Windows 11">
        <parameter name="platformName" value="Windows 11"/>
        <parameter name="browserName" value="Chrome"/>
        <parameter name="browserVersion" value="84.0"/>

        <classes>
            <class name="com.orangeHRM.Level_28_SauceLab"></class>
        </classes>
    </test>

    <test name="Run on FIREFOX -Windows 10">
        <parameter name="platformName" value="Windows 10"/>
        <parameter name="browserName" value="Firefox"/>
        <parameter name="browserVersion" value="136"/>

        <classes>
            <class name="com.orangeHRM.Level_28_SauceLab"></class>
        </classes>
    </test>

    <test name="Run on Safari - Mac">
        <parameter name="platformName" value="macOS 13"/>
        <parameter name="browserName" value="Safari"/>
        <parameter name="browserVersion" value="17"/>

        <classes>
            <class name="com.orangeHRM.Level_28_SauceLab"></class>
        </classes>
    </test>

</suite>